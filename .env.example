# Copy to .env.local and fill in.
SITE_URL=http://localhost:3077

# Stripe: Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase: Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...

# Studio staff who can open /admin (comma-separated). They also get sketch-approval emails.
ADMIN_EMAILS=you@example.com

# Resend (order, sketch and shipping emails). Without a key, emails are logged instead of sent.
RESEND_API_KEY=re_...
EMAIL_FROM=Studio Name <orders@your-domain.com>
